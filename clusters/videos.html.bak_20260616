<!doctype html><meta charset=utf-8><title>HoReCo Segmented Videos</title>
<style>
 body{font:14px system-ui;background:#111;color:#eee;margin:16px}
 table{border-collapse:collapse;width:100%}th,td{padding:6px 10px;border-bottom:1px solid #333;text-align:left}
 th{cursor:pointer;background:#1b1b1b;position:sticky;top:0}
 a{color:#6cf}
 select{background:#222;color:#eee;border:1px solid #444;border-radius:4px;padding:4px}
</style>
<h2>Segmented videos <small id=stat></small>
 <select id=cat style="font-size:13px;margin-left:8px"><option value="">All categories</option><option value=horeco>horeco</option><option value=health_holland>health_holland</option></select>
</h2>
<table><thead><tr>
 <th data-k=video>video</th><th data-k=category>category</th><th data-k=n_segments>#segs</th>
 <th data-k=conf_min>conf min</th><th data-k=conf_max>conf max</th>
 <th data-k=conf_mean>conf mean</th><th data-k=novelty_count>novel</th><th>correct</th>
</tr></thead><tbody id=tb></tbody></table>
<script>
const ABS="https://signcollect.nl/annotation-tool/clusters/out/";
let rows=[],dir=1,key='conf_min',cat='';
function color(v){const h=Math.round(v*120);return `background:hsl(${h},60%,20%)`;}
function draw(){
  let view=cat?rows.filter(r=>r.category===cat):rows.slice();
  view.sort((a,b)=>(a[key]>b[key]?1:-1)*dir);
  document.getElementById('tb').innerHTML=view.map(r=>{
   const eaf=ABS+r.eaf;
   const tool=`tool/?video=${encodeURIComponent(r.video_url)}&eaf=${encodeURIComponent(eaf)}`;
   return `<tr><td>${r.video}</td><td>${r.category||''}</td><td>${r.n_segments}</td>
    <td style="${color(r.conf_min)}">${r.conf_min.toFixed(2)}</td>
    <td style="${color(r.conf_max)}">${r.conf_max.toFixed(2)}</td>
    <td style="${color(r.conf_mean)}">${r.conf_mean.toFixed(2)}</td>
    <td>${r.novelty_count}</td><td><a href="${tool}">open ▶</a></td></tr>`;
  }).join('');
  document.getElementById('stat').textContent=`(${view.length})`;
}
document.querySelectorAll('th[data-k]').forEach(th=>th.onclick=()=>{
  const k=th.dataset.k; dir=(k===key)?-dir:1; key=k; draw();});
document.getElementById('cat').addEventListener('change',e=>{cat=e.target.value;draw();});
fetch("out/videos.json").then(r=>r.json()).then(d=>{rows=d;draw();});
</script>
